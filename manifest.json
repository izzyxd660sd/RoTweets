{
  "manifest_version": 3,
  "name": "RoTweet Fresh",
  "version": "1.1.1",
  "description": "Game-aware X feed sidebar for Roblox, with curated game accounts and isolated UI.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.pcstyle.dev/*",
    "https://rsshub.app/*",
    "https://rsshub.rssforever.com/*",
    "https://rsshub.pseudoyu.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/games/*"
      ],
      "js": [
        "games.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
